# Copier ce fichier en ".env" (jamais commité) et remplir les valeurs réelles.

# URL du projet Supabase (identique à SUPABASE_URL dans index.html)
SUPABASE_URL=https://jbiphusmneoccarwkucq.supabase.co

# Clé service_role (Dashboard Supabase -> Project Settings -> API -> service_role)
# ATTENTION : cette clé contourne toutes les protections. Ne jamais la mettre dans un fichier
# commité sur GitHub, ne jamais la coller dans index.html/gestion.html/saisie.html.
SUPABASE_SERVICE_ROLE_KEY=

# Dossier surveillé : chemin local Windows aujourd'hui, chemin réseau (\\NAS\...) demain.
# Fonctionne à l'identique dans les deux cas, aucune modification de code nécessaire.
WATCH_DIR=C:\Users\JOSSE\OneDrive\Bureau\DUbail a ranger dans DRIVE\A METTRE DANS DEXT

# Optionnel : dossier racine d'archivage, commun aux factures et aux devis
# (voir DEVIS_ARCHIVE_DIR plus bas). Une fois une facture validée dans le GMAO,
# le fichier original (s'il est toujours dans WATCH_DIR) est déplacé vers
# ARCHIVE_DIR\<SAVADUR|PERSO>\Factures\<bien>\<zone>\<motif>\. Laisser vide
# pour désactiver l'archivage.
ARCHIVE_DIR=D:\Antoine\GMAO

# Pipeline devis (import_devis.py) - separe du pipeline factures pour le dossier
# surveille (un devis n'est pas une piece a transmettre au comptable, donc pas
# dans WATCH_DIR), mais partage la meme racine d'archivage que ARCHIVE_DIR :
# DEVIS_ARCHIVE_DIR\<SAVADUR|PERSO>\Devis\<bien>\<zone>\<motif>\.
# Chemin temporaire sur le disque D, a remplacer par un chemin reseau (\\NAS\...)
# une fois le NAS en service - aucune modification de code necessaire.
DEVIS_WATCH_DIR=D:\Antoine\Devis a traiter
DEVIS_ARCHIVE_DIR=D:\Antoine\GMAO
