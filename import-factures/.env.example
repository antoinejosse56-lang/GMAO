# Copier ce fichier en ".env" (jamais commité) et remplir les valeurs réelles.

# URL du projet Supabase (identique à SUPABASE_URL dans index.html)
SUPABASE_URL=https://jbiphusmneoccarwkucq.supabase.co

# Clé service_role (Dashboard Supabase -> Project Settings -> API -> service_role)
# ATTENTION : cette clé contourne toutes les protections. Ne jamais la mettre dans un fichier
# commité sur GitHub, ne jamais la coller dans index.html/gestion.html/saisie.html.
SUPABASE_SERVICE_ROLE_KEY=

# Dossier surveillé (factures) : chemin local ou réseau (\\NAS\...), fonctionne
# à l'identique dans les deux cas. Sert aussi de file d'attente manuelle vers
# Dext au quotidien - volontairement laissé en local (OneDrive) plutôt que
# migré vers le NAS avec ARCHIVE_DIR, pour ne pas perturber ce flux actif.
WATCH_DIR=C:\Users\JOSSE\OneDrive\Bureau\DUbail a ranger dans DRIVE\A METTRE DANS DEXT

# Pipeline devis (import_devis.py) - dossier surveillé séparé de WATCH_DIR (un
# devis n'est pas une pièce à transmettre au comptable). Migré sur le NAS,
# dans un sous-dossier neutre "_En_cours" (un devis pas encore rattaché à un
# bien n'est pas classable SAVADUR/Perso) sous NAS_PERSO_PATH (voir plus bas).
DEVIS_WATCH_DIR=\\192.168.1.x\Documents GMAO Perso\_En_cours\Devis a traiter

# ARCHIVE_DIR / DEVIS_ARCHIVE_DIR n'existent plus : une fois une facture/un
# devis validé dans le GMAO, le fichier est archivé directement sous
# NAS_SAVADUR_PATH ou NAS_PERSO_PATH (voir plus bas) selon le bien concerné,
# dans Factures\<bien>\<zone>\<motif>\ ou Devis\<bien>\<zone>\<motif>\.

# Pipeline documents génériques (import_documents.py) - DPE, attestation
# d'assurance, diagnostic, annexe de bail... Dossier partagé sur le NAS (donc
# accessible par Pauline sans rien configurer côté Windows, y compris depuis
# un smartphone : app "Fichiers" sur iOS via "Se connecter au serveur" ->
# smb://192.168.1.x, ou un gestionnaire de fichiers compatible SMB / l'appli
# du NAS sur Android). Même dossier neutre "_En_cours" que DEVIS_WATCH_DIR
# (un document déposé là n'est pas encore classé SAVADUR/Perso).
DOCUMENTS_WATCH_DIR=\\192.168.1.x\Documents GMAO Perso\_En_cours\Documents a importer

# import_mailbox.py - scanne une ou plusieurs boites Gmail (IMAP) a la
# recherche du libelle GMAIL_LABEL et depose les pieces jointes dans WATCH_DIR
# (ou DEVIS_WATCH_DIR si "devis" apparait dans le sujet/nom de fichier), comme
# si elles y avaient ete glissees a la main. Le mot de passe d'application se
# genere depuis https://myaccount.google.com/apppasswords (necessite la
# validation en 2 etapes activee). Rajouter GMAIL_ACCOUNT_3/GMAIL_APP_PASSWORD_3
# etc. pour une 3e boite, aucune modification de code necessaire.
GMAIL_ACCOUNT_1=savadur56@gmail.com
GMAIL_APP_PASSWORD_1=
GMAIL_ACCOUNT_2=antoinejosse56@gmail.com
GMAIL_APP_PASSWORD_2=
GMAIL_LABEL=A importer

# sync_gamme_calendar.py - cree/tient a jour un evenement Google Calendar pour
# chaque bon de travaux issu d'une gamme (work_orders.gamme_id renseigne).
# Client OAuth de type "Application de bureau" (Google Cloud Console ->
# APIs & Services -> Identifiants), avec l'API Google Calendar activee sur le
# meme projet. GOOGLE_CALENDAR_REFRESH_TOKEN s'obtient une seule fois en
# executant google_calendar_auth.py (ouvre un navigateur pour l'autorisation).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Partages NAS (2 racines distinctes) - utilises par backup_to_nas.py (copie
# de sauvegarde des 3 buckets Supabase Storage) ET par import_factures.py /
# import_devis.py (archivage des factures/devis valides) / import_mailbox.py
# (acces a DEVIS_WATCH_DIR), selon qu'un fichier concerne SAVADUR/Dubail ou
# tout le reste (perso). Chemins UNC complets (pas de lettre de lecteur),
# authentifies via "net use" au demarrage de chaque script (identifiant dedie
# cote NAS, pas besoin d'ouvrir de session Windows avec ce compte).
NAS_SAVADUR_PATH=\\192.168.1.x\Documents GMAO Savadur
NAS_PERSO_PATH=\\192.168.1.x\Documents GMAO Perso
NAS_USER=
NAS_PASSWORD=
